{
  "name": "neo4j-driver-query-api-connection",
  "version": "6.0.0-dev",
  "description": "Implements the connection with the Neo4j Database using the Query API Protocol",
  "main": "lib/index.js",
  "types": "types/index.d.ts",
  "type": "commonjs",
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublish": "downdoc README.adoc",
    "postpublish": "downdoc README.adoc",
    "test": "pnpm test::unit && pnpm test::integration",
    "test::watch": "jest --watch",
    "test::unit": "jest --passWithNoTests",
    "test::integration": "jest --passWithNoTests -c jest.integration.config.ts",
    "prepare": "pnpm run build",
    "clean": "rm -fr node_modules lib types"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/neo4j-drivers/neo4j-javascript-driver.git"
  },
  "keywords": [
    "http",
    "neo4j",
    "driver"
  ],
  "browser": {
    "./lib/http-connection/node/stream.js": "./lib/http-connection/browser/stream.js"
  },
  "author": "Neo4j",
  "contributors": [
    {
      "name": "Max Gustafsson"
    },
    {
      "name": "Antonio Barcélos"
    }
  ],
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/neo4j-drivers/neo4j-javascript-driver/issues"
  },
  "homepage": "https://github.com/neo4j-drivers/neo4j-javascript-driver#readme",
  "devDependencies": {
    "@types/jest": "^29.5.3",
    "downdoc": "^1.0.2-stable",
    "fast-check": "^3.10.0",
    "jest": "^29.6.2",
    "testcontainers": "^8.16.0",
    "ts-jest": "^29.1.1",
    "ts-node": "10.9.2",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "neo4j-driver-core": "workspace:*"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
