{
  "compilerOptions": {
    "module": "es6",
    "target": "es6",
    "lib": ["es6", "ES2017.Object", "dom", "es2020.bigint", "esnext.asynciterable"],
    "types": ["node"],
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "strictNullChecks": true,
    "moduleResolution": "node",
    "esModuleInterop": true,
    "allowJs": true
  },
  "include": ["types/**/*.ts", "test/types/**/*.ts", "*.ts", "*src/*.ts"]
}
